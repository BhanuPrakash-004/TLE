# ==========================================
# Ragnarok Trial of the Nine Realms — Environment Configuration
# ==========================================

# Server Port & Environment
PORT=3000
NODE_ENV=development

# Simulated Clock (Target As-Of Date)
AS_OF_DATE=2027-01-25

# ==============================================================================
# DATABASE BACKEND SELECTOR
# Set DB_BACKEND=docker   → local Docker Postgres+pgvector (run: docker compose up -d)
# Set DB_BACKEND=supabase → Supabase cloud Postgres (fill SUPABASE_* vars below)
# ==============================================================================
DB_BACKEND=docker

# --- Docker Postgres + pgvector -------------------------------------------
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ragnarok_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=ragnarok_db

# --- Supabase (online Postgres) --------------------------------------------
# SUPABASE_DB_URL: Transaction Pooler URI from Supabase Dashboard
#   → Settings → Database → Connection string → URI  (port 6543)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>
SUPABASE_DB_URL=postgresql://postgres.<your-project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# Vite / frontend env vars (must be VITE_ prefixed)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>

# Document Pool & Pack Location
DOCS_PATH=./03_Ragnarok Trial of the Nine Realms/dev_pack_E5/docs
PACK_PATH=./03_Ragnarok Trial of the Nine Realms/dev_pack_E5

# OpenRouter Configuration (for State-Of-The-Art Accuracy)
OPENROUTER_API_KEY=
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b:free
RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b:free
PREFER_OPENROUTER=true

# Local Fallback Configuration (Zero-Latency & Offline Redundancy)
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
LOCAL_EMBEDDING_DIM=384

# LLM Providers (for Agent Orchestration in Phase 3 & 4)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
